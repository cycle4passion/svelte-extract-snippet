{
	"name": "svelte-extract-snippet",
	"displayName": "Svelte Extract as {#snippet}",
	"description": "Extract selected Svelte 5 template markup into a named {#snippet ...} with parameters, and replace with {@render ...}",
	"version": "1.0.0",
	"publisher": "scottrhamy",
	"engines": {
		"vscode": "^1.95.0"
	},
	"categories": [
		"Other",
		"Programming Languages"
	],
	"keywords": [
		"svelte",
		"svelte5",
		"svelkit",
		"snippet",
		"extract",
		"extractor",
		"refactor",
		"render"
	],
	"icon": "images/icon.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/cycle4passion/svelte-extract-snippet"
	},
	"bugs": {
		"url": "https://github.com/cycle4passion/svelte-extract-snippet/issues"
	},
	"homepage": "https://github.com/cycle4passion/svelte-extract-snippet#readme",
	"license": "MIT",
	"activationEvents": [],
	"main": "./dist/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "svelte-extract-snippet.extract",
				"title": "Extract as Svelte {#snippet ...}",
				"category": "Svelte"
			}
		],
		"menus": {
			"editor/context": [
				{
					"command": "svelte-extract-snippet.extract",
					"when": "editorHasSelection && (resourceExtname == .svelte || editorLangId == svelte)",
					"group": "1_modification"
				}
			]
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run esbuild-base -- --minify",
		"package": "vsce package",
		"publish": "vsce publish",
		"esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
		"esbuild": "npm run esbuild-base -- --sourcemap",
		"esbuild-watch": "npm run esbuild-base -- --sourcemap --watch",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@secretlint/secretlint-rule-preset-recommend": "^13.0.2",
		"@types/node": "^20.0.0",
		"@types/vscode": "^1.95.0",
		"@vscode/vsce": "^3.0.0",
		"esbuild": "^0.20.0",
		"typescript": "^5.3.0",
		"vitest": "^4.1.7"
	}
}
